---
import { getCollection } from 'astro:content';
import { blogPostPath, sourceSlug } from '@/utils/routes';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts
    .filter((post) => !post.data.draft)
    .flatMap((post) => {
      const canonicalPath = blogPostPath(post.data.category, post.data.title);
      const legacySlugs = new Set([post.id, sourceSlug(post.id)]);

      return [...legacySlugs].map((slug) => ({
        params: { slug },
        props: { canonicalPath },
      }));
    });
}

const { canonicalPath } = Astro.props;
return Astro.redirect(canonicalPath, 301);
---
