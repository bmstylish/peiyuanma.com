---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostCard from '@/components/BlogPostCard.astro';
import {
  BLOG_CATEGORIES,
  BLOG_CATEGORY_KEYS,
  blogPostPath,
  type BlogCategory,
} from '@/utils/routes';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const publishedCategories = new Set(
    posts.filter((post) => !post.data.draft).map((post) => post.data.category),
  );

  return BLOG_CATEGORY_KEYS.filter((category) => publishedCategories.has(category)).map(
    (category) => ({ params: { category }, props: { category } }),
  );
}

const { category } = Astro.props as { category: BlogCategory };
const categoryDetails = BLOG_CATEGORIES[category];
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={`${categoryDetails.label} • Blog`}
  description={categoryDetails.description}
>
  <header class="category-header">
    <p class="eyebrow">Blog category</p>
    <h1>{categoryDetails.label}</h1>
    <p>{categoryDetails.description}</p>
  </header>

  <div class="posts-list">
    {posts.map((post) => (
      <BlogPostCard
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        tags={post.data.tags}
        category={post.data.category}
        href={blogPostPath(post.data.category, post.data.title)}
      />
    ))}
  </div>

  <a class="back-link" href="/blog/">← All blog categories</a>
</BaseLayout>

<style>
  .category-header {
    margin-bottom: calc(var(--spacing-unit) * 5);
    padding-bottom: calc(var(--spacing-unit) * 3);
    border-bottom: 1px solid var(--color-border);
  }

  .category-header > p:last-child {
    max-width: 680px;
    color: var(--color-text-muted);
  }

  .eyebrow {
    margin-bottom: calc(var(--spacing-unit) * 1);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 3);
  }

  .back-link {
    display: inline-block;
    margin-top: calc(var(--spacing-unit) * 6);
    color: var(--color-text-muted);
  }
</style>
