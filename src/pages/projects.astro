---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import TagFilter from '@/components/TagFilter.astro';
import { projectPath } from '@/utils/routes';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.order - b.data.order);
const allTags = [...new Set(projects.flatMap((project) => project.data.tags).map((tag) => tag.toLowerCase()))].sort();
---

<BaseLayout
  title="Projects • Peiyuan Ma"
  description="Projects I've built while learning cybersecurity and infrastructure."
>
  <h1 class="listing-title">Projects</h1>

  <TagFilter tags={allTags} label="Project tags" />

  <div class="projects-grid">
    {projects.map((project) => (
      <ProjectCard
        title={project.data.title}
        description={project.data.description}
        date={project.data.date}
        tags={project.data.tags}
        github={project.data.github}
        demo={project.data.demo}
        href={project.data.writeup ? projectPath(project.data.title) : undefined}
        status={project.data.status}
        lessons={project.data.lessons}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 4);
  }

</style>
