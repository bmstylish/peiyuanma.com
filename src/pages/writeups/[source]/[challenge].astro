---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagLink from '@/components/TagLink.astro';
import { sourceSlug, titleSlug, writeupPath, writeupSourcePath } from '@/utils/routes';

export async function getStaticPaths() {
  const labs = await getCollection('labs');

  return labs
    .filter((lab) => !lab.data.draft)
    .flatMap((lab) => {
      const source = sourceSlug(lab.data.source);
      const canonicalSlug = titleSlug(lab.data.title);
      const legacySlugs = new Set([lab.id, sourceSlug(lab.id)]);

      return [
        { params: { source, challenge: canonicalSlug }, props: { lab } },
        ...[...legacySlugs]
          .filter((slug) => slug !== canonicalSlug)
          .map((slug) => ({
            params: { source, challenge: slug },
            props: { lab, redirectTo: writeupPath(source, lab.data.title) },
          })),
      ];
    });
}

const { lab, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);

const { Content } = await lab.render();
const allSources = await getCollection('writeupSources');
const sourceId = sourceSlug(lab.data.source);
const source = allSources.find(
  (entry) => !entry.data.draft && sourceSlug(entry.id) === sourceId,
);

const formattedDate = lab.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${lab.data.title} • Writeups`} description={lab.data.description}>
  <article class="lab-post">
    <header class="post-header">
      <h1>{lab.data.title}</h1>

      <div class="post-meta">
        <div class="post-context">
          {source && (
            <a href={writeupSourcePath(sourceId)}>{source.data.name}</a>
          )}
          {source && <span aria-hidden="true">/</span>}
          <time datetime={lab.data.date.toISOString()}>{formattedDate}</time>
        </div>

        <div class="post-tags">
          <span class:list={['badge', lab.data.status.replace('-', '')]}>{lab.data.status}</span>
          {lab.data.tags.map((tag) => <TagLink tag={tag} />)}
        </div>
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href={writeupSourcePath(sourceId)} class="back-link">
        ← Back to {source?.data.name ?? 'writeups'}
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .lab-post {
    max-width: 720px;
  }

  .post-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-context {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--color-text-faint);
  }

  .post-context a,
  .post-meta time {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-context a:hover,
  .post-context a:focus-visible {
    color: var(--color-text-heading);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .post-content {
    margin-bottom: 64px;
  }

  .post-footer {
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-accent);
  }
</style>
