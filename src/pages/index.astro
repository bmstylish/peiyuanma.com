---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Peiyuan Ma • Cybersecurity Portfolio"
  description="Cybersecurity student portfolio: projects, labs, and technical writing."
>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-content">
      <p class="hello">hi, i’m</p>
      <h1 id="home-title">Peiyuan <span>(Bobby)</span> Ma</h1>
      <p class="lead">
        Cybersecurity student building practical projects,<br class="desktop-break" />
        running labs, and documenting what I learn.
      </p>
      <p class="prompt" aria-hidden="true">&gt;_</p>

      <nav class="hero-links" aria-label="Explore my work">
        <a href="/projects/">
          <span>Projects</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/labs/">
          <span>Writeups</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/blog/">
          <span>Blog</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: grid;
    align-items: center;
    padding: 2rem var(--page-gutter);
  }

  .hero-content {
    width: min(100%, 1010px);
    margin-inline: auto;
  }

  .hello,
  .prompt {
    font-family: var(--font-mono);
  }

  .hello {
    margin: 0 0 1.45rem;
    color: var(--color-accent);
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
    letter-spacing: 0.04em;
  }

  h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(3.1rem, 6.4vw, 6.25rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 span {
    white-space: nowrap;
  }

  .lead {
    margin: clamp(2rem, 4.5vh, 3.25rem) 0 0;
    color: var(--color-text);
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    line-height: 1.58;
  }

  .prompt {
    margin: 2.15rem 0 0;
    color: var(--color-accent);
    font-size: 1.05rem;
  }

  .hero-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(150px, 190px));
    gap: clamp(2.5rem, 7vw, 6rem);
    margin-top: clamp(3.25rem, 7vh, 5rem);
  }

  .hero-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 0.8rem;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-text-heading);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    line-height: 1;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .hero-links .arrow {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    transition: transform 180ms ease;
  }

  .hero-links a:hover,
  .hero-links a:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-links a:hover .arrow,
  .hero-links a:focus-visible .arrow {
    transform: translateX(0.35rem);
  }

  @media (max-width: 760px) {
    .hero {
      align-items: center;
      padding-block: 1.5rem;
    }

    h1 {
      font-size: clamp(2.65rem, 13vw, 4.4rem);
      line-height: 1.01;
    }

    .desktop-break {
      display: none;
    }

    .hello {
      margin-bottom: 1rem;
    }

    .lead {
      margin-top: 1.75rem;
      line-height: 1.48;
    }

    .prompt {
      margin-top: 1.65rem;
    }

    .hero-links {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      width: min(100%, 250px);
      margin-top: 2.25rem;
    }

    .hero-links a {
      padding-bottom: 0.6rem;
      font-size: 1.2rem;
    }
  }

  @media (max-height: 720px) and (min-width: 761px) {
    .hello {
      margin-bottom: 1rem;
    }

    .lead,
    .prompt {
      margin-top: 1.4rem;
    }

    .hero-links {
      margin-top: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-links .arrow {
      transition: none;
    }
  }
</style>
