---
import { getCollection } from 'astro:content';
import { sourceSlug, titleSlug, writeupPath } from '@/utils/routes';

export async function getStaticPaths() {
  const labs = await getCollection('labs');

  return labs
    .filter((lab) => !lab.data.draft)
    .flatMap((lab) => {
      const legacySlugs = new Set([
        titleSlug(lab.data.title),
        lab.id,
        sourceSlug(lab.id),
      ]);
      const redirectTo = writeupPath(lab.data.source, lab.data.title);

      return [...legacySlugs].map((slug) => ({
        params: { slug },
        props: { redirectTo },
      }));
    });
}

const { redirectTo } = Astro.props;
return Astro.redirect(redirectTo, 301);
---
