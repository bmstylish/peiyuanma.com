---
import { getCollection } from 'astro:content';
import { getCtfWeekDetails } from '@/data/ctfWeeks';
import {
  journalWeekPath,
  sourceSlug,
  titleSlug,
} from '@/utils/routes';

export async function getStaticPaths() {
  const [projects, journalEntries] = await Promise.all([
    getCollection('projects'),
    getCollection('ctfDays'),
  ]);

  return projects.flatMap((project) => {
    if (project.data.draft || !project.data.journal) return [];

    const projectEntries = journalEntries.filter(
      (entry) => !entry.data.draft && entry.data.project === project.data.journal,
    );
    const weeks = getCtfWeekDetails(projectEntries.map((entry) => entry.data.week));
    const projectSlugs = new Set([sourceSlug(project.id), titleSlug(project.data.title)]);

    return [...projectSlugs].flatMap((projectSlug) =>
      weeks.map((week) => ({
        params: { project: projectSlug, week: week.slug },
        props: {
          canonicalPath: journalWeekPath(project.data.title, week.number, week.title),
        },
      })),
    );
  });
}

const { canonicalPath } = Astro.props;
return Astro.redirect(canonicalPath, 301);
---
