---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtfDayCard from '@/components/CtfDayCard.astro';
import { getCtfWeekDetails } from '@/data/ctfWeeks';

export async function getStaticPaths() {
  const [projects, journalEntries] = await Promise.all([
    getCollection('projects'),
    getCollection('ctfDays'),
  ]);

  return projects.flatMap((project) => {
    if (project.data.draft || !project.data.journal) return [];

    const projectEntries = journalEntries.filter(
      (entry) => !entry.data.draft && entry.data.project === project.data.journal,
    );
    const availableWeeks = getCtfWeekDetails(projectEntries.map((entry) => entry.data.week));

    return availableWeeks.map((week) => ({
      params: {
        project: project.id.replace(/\.md$/, ''),
        week: week.slug,
      },
      props: {
        project,
        week,
        availableWeeks,
        entries: projectEntries
          .filter((entry) => entry.data.week === week.number)
          .sort((a, b) => a.data.day - b.data.day),
      },
    }));
  });
}

const { project, week, availableWeeks, entries } = Astro.props;
const projectSlug = project.id.replace(/\.md$/, '');
const weekIndex = availableWeeks.findIndex((item) => item.number === week.number);
const previousWeek = availableWeeks[weekIndex - 1];
const nextWeek = availableWeeks[weekIndex + 1];
---

<BaseLayout title={`${week.label}: ${week.title} • ${project.data.title}`} description={week.description}>
  <article class="week-page">
    <header class="week-header">
      <p class="week-label">{week.label}</p>
      <h1>{week.title}</h1>
      <p class="week-description">{week.description}</p>
    </header>

    <div class="day-grid">
      {entries.map((entry) => (
        <CtfDayCard
          day={entry.data.day}
          title={entry.data.title}
          description={entry.data.description}
          status={entry.data.status}
          href={`/projects/${projectSlug}/days/${entry.id.replace(/\.md$/, '')}`}
        />
      ))}
    </div>

    <nav class="week-navigation" aria-label="Journal navigation">
      <div>
        {previousWeek && (
          <a href={`/projects/${projectSlug}/weeks/${previousWeek.slug}`}>
            ← {previousWeek.label}
          </a>
        )}
      </div>
      <a href={`/projects/${projectSlug}`} class="overview-link">Project overview</a>
      <div class="next-link">
        {nextWeek && (
          <a href={`/projects/${projectSlug}/weeks/${nextWeek.slug}`}>
            {nextWeek.label} →
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .week-header {
    max-width: 720px;
    margin-bottom: calc(var(--spacing-unit) * 6);
    padding-bottom: calc(var(--spacing-unit) * 4);
    border-bottom: 1px solid var(--color-border);
  }

  .week-label {
    margin-bottom: calc(var(--spacing-unit) * 1);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .week-description {
    max-width: 680px;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .day-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--spacing-unit) * 2);
  }

  .week-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
    margin-top: calc(var(--spacing-unit) * 8);
    padding-top: calc(var(--spacing-unit) * 4);
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .next-link {
    text-align: right;
  }

  .overview-link {
    color: var(--color-text-muted);
  }

  @media (max-width: 680px) {
    .day-grid {
      grid-template-columns: 1fr;
    }

    .week-navigation {
      grid-template-columns: 1fr 1fr;
    }

    .overview-link {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: center;
    }
  }
</style>
