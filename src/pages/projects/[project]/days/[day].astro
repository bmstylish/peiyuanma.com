---
import { getCollection } from 'astro:content';
import {
  journalDayPath,
  sourceSlug,
  titleSlug,
} from '@/utils/routes';

export async function getStaticPaths() {
  const [projects, journalEntries] = await Promise.all([
    getCollection('projects'),
    getCollection('ctfDays'),
  ]);

  return journalEntries
    .filter((entry) => !entry.data.draft)
    .flatMap((entry) => {
      const project = projects.find((item) => item.data.journal === entry.data.project);
      if (!project || project.data.draft) return [];

      const projectSlugs = new Set([sourceSlug(project.id), titleSlug(project.data.title)]);
      return [...projectSlugs].map((projectSlug) => ({
        params: {
          project: projectSlug,
          day: sourceSlug(entry.id),
        },
        props: {
          canonicalPath: journalDayPath(project.data.title, entry.data.day, entry.data.title),
        },
      }));
    });
}

const { canonicalPath } = Astro.props;
return Astro.redirect(canonicalPath, 301);
---
