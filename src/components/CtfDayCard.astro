---
interface Props {
  day: number;
  title: string;
  description: string;
  status: 'planned' | 'in-progress' | 'complete';
  href: string;
}

const { day, title, description, status, href } = Astro.props;
---

<article class="day-card">
  <div class="day-card-header">
    <span class="day-number">Day {day}</span>
    <span class:list={['badge', status]}>{status}</span>
  </div>

  <h3>{title}</h3>
  <p>{description}</p>

  <a href={href} class="day-link" aria-label={`Open Day ${day}: ${title}`}>
    Open daily log
    <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
      <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
    </svg>
  </a>
</article>

<style>
  .day-card {
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: calc(var(--spacing-unit) * 3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 0.2s, transform 0.2s;
  }

  .day-card:hover {
    border-color: var(--color-accent-dim);
    transform: translateY(-2px);
  }

  .day-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
    margin-bottom: calc(var(--spacing-unit) * 2);
  }

  .day-number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0 0 calc(var(--spacing-unit) * 1.5);
    font-size: 1.125rem;
  }

  p {
    flex: 1;
    margin-bottom: calc(var(--spacing-unit) * 3);
    color: var(--color-text-muted);
    font-size: 0.925rem;
  }

  .day-link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 1);
    width: fit-content;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .day-card {
      transition: none;
    }

    .day-card:hover {
      transform: none;
    }
  }
</style>
