---
const year = new Date().getUTCFullYear();
---

<footer>
  <div class="footer-content">
    <p class="footer-text">
      © {year} Peiyuan (Bobby) Ma
      <span class="divider" aria-hidden="true">/</span>
      Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      <span class="divider" aria-hidden="true">/</span>
      <a href="http://bit.ly/WatchDogsFont" target="_blank" rel="noopener">Hacked typeface</a>
    </p>
    <div class="footer-links">
      <a href="mailto:mpy.peiyuan@gmail.com">Email</a>
      <span class="link-divider" aria-hidden="true"></span>
      <a href="https://github.com/bmstylish" target="_blank" rel="noopener">
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <span class="link-divider" aria-hidden="true"></span>
      <a href="https://linkedin.com/in/mpy-bobby" target="_blank" rel="noopener">
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: 4rem;
  }

  :global(body.is-home) footer {
    margin-top: 0;
  }

  .footer-content {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 2.35rem var(--shell-gutter) 3.1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .footer-text,
  .footer-links a {
    margin: 0;
    color: var(--color-text-faint);
    font-size: 0.78rem;
  }

  .divider {
    margin: 0 1.15rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-accent);
  }

  .link-divider {
    width: 1px;
    height: 0.9rem;
    background: var(--color-border-strong);
  }

  @media (max-width: 650px) {
    .footer-content {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.2rem;
    }

    .divider {
      margin: 0 0.55rem;
    }
  }

  @media (max-width: 650px) and (min-height: 760px) {
    :global(body.is-home) .footer-content {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding-block: 1.1rem 1.35rem;
    }

    :global(body.is-home) .footer-text,
    :global(body.is-home) .footer-links a {
      font-size: 0.63rem;
    }

    :global(body.is-home) .divider {
      margin-inline: 0.35rem;
    }

    :global(body.is-home) .footer-links {
      gap: 0.55rem;
    }
  }
</style>
