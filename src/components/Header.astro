---
import NavigationIcon from '@/components/NavigationIcon.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/projects/', label: 'Projects', icon: 'projects', activePath: '/projects/' },
  { href: '/writeups/', label: 'Writeups', icon: 'writeups', activePath: '/writeups/' },
  { href: '/blog/', label: 'Blog', icon: 'blog', activePath: '/blog/' },
  { href: '/', label: 'About', icon: 'about', activePath: '/' },
] as const;
---

<header>
  <div class="header-content">
    <a href="/" class="logo" aria-label="Peiyuan Ma, home">peiyuan.ma</a>
    <nav aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-label={item.label}
          title={item.label}
          data-label={item.label}
          class:list={[
            'nav-link',
            {
              active:
                item.activePath === '/'
                  ? currentPath === '/'
                  : currentPath.startsWith(item.activePath),
            },
          ]}
        >
          <NavigationIcon name={item.icon} />
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    position: relative;
    z-index: 100;
    background: transparent;
  }

  .header-content {
    width: 100%;
    max-width: 1440px;
    min-height: 82px;
    margin: 0 auto;
    padding: 1rem var(--shell-gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.65rem);
  }

  .nav-link {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0.1rem;
    color: var(--color-text-muted);
    filter: brightness(0.66);
    transition: filter 180ms ease, transform 180ms ease;
  }

  .nav-link.active {
    filter: brightness(1);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }

  .nav-link::before {
    content: attr(data-label);
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 50%;
    z-index: 2;
    padding: 0.28rem 0.45rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-text-heading);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.2rem);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .nav-link:hover::before,
  .nav-link:focus-visible::before {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.28rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateX(-50%);
  }

  @media (max-width: 620px) {
    .header-content {
      min-height: 62px;
      padding-block: 0.55rem;
    }

    nav {
      gap: clamp(0.35rem, 1.5vw, 0.7rem);
    }

    .logo {
      font-size: 0.82rem;
    }

    .nav-link::before {
      display: none;
    }
  }

  @media (max-width: 365px) {
    .logo {
      font-size: 0.72rem;
    }
  }
</style>
