---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/projects/', label: 'Projects', activePath: '/projects/' },
  { href: '/labs/', label: 'Writeups', activePath: '/labs/' },
  { href: '/blog/', label: 'Blog', activePath: '/blog/' },
  { href: '/', label: 'About', activePath: '/' },
];
---

<header>
  <div class="header-content">
    <a href="/" class="logo" aria-label="Peiyuan Ma, home">peiyuan.ma</a>
    <nav aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'nav-link',
            {
              active:
                item.activePath === '/'
                  ? currentPath === '/'
                  : currentPath.startsWith(item.activePath),
            },
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    position: relative;
    z-index: 100;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
  }

  .header-content {
    width: 100%;
    max-width: 1440px;
    min-height: 82px;
    margin: 0 auto;
    padding: 1.4rem var(--shell-gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: var(--color-text-heading);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1.65rem, 3.4vw, 3.25rem);
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    transition: color 180ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.18rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateX(-50%);
  }

  @media (max-width: 620px) {
    .header-content {
      min-height: 62px;
      padding-block: 0.8rem;
    }

    nav {
      gap: clamp(0.7rem, 3.2vw, 1.15rem);
    }

    .logo {
      font-size: 0.76rem;
    }

    .nav-link {
      font-size: 0.73rem;
    }
  }

  @media (max-width: 365px) {
    .header-content {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>
