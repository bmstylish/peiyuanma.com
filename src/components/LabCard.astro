---
import TagLink from './TagLink.astro';

interface Props {
  title: string;
  difficulty: "beginner" | "intermediate" | "advanced";
  tags: string[];
  status: "complete" | "in-progress" | "planned";
  description: string;
  href?: string; // if provided, card becomes clickable
}

const { title, difficulty, objective, tags, status, description, href } = Astro.props;

const difficultyColors: Record<Props["difficulty"], string> = {
  beginner: "var(--color-success)",
  intermediate: "var(--color-warning)",
  advanced: "var(--color-accent)",
};

function statusClass(s: Props["status"]) {
  // matches CSS badge classes
  return s.replace("-", "");
}
---

<article class:list={["lab-card", { "lab-card-link": href }]}>
  <div class="lab-header">
    <h3>{href ? <a href={href}>{title}</a> : title}</h3>
    <div class="lab-meta">
      <span class="difficulty" style={`color:${difficultyColors[difficulty]}`}>
        {difficulty}
      </span>
      <span class:list={["badge", statusClass(status)]}>{status}</span>
    </div>
  </div>

  {!href && objective && (
    <div class="lab-objective">
      <strong>Objective:</strong> {objective}
    </div>
  )}

  <p class="lab-description">{description}</p>

  <div class="lab-tags">
    <strong>Tags:</strong>
    {tags.map((tag) => <TagLink tag={tag} />)}
  </div>
</article>

<style>
  .lab-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: calc(var(--spacing-unit) * 3);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 2);
    color: inherit;
    text-decoration: none;
  }

  .lab-card-link:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .lab-header {
    display: flex;
    flex-direction: space-between;
    gap: calc(var(--spacing-unit) * 1);
    align-items: center;
  }

  .lab-header h3 {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-text-heading);
  }

  .lab-header h3 a {
    color: inherit;
  }

  .lab-meta {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
  }

  .difficulty {
    font-size: 0.8125rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .lab-objective {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .lab-objective strong {
    color: var(--color-text-heading);
  }

  .lab-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .lab-tags {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .lab-tags strong {
    color: var(--color-text-heading);
  }
</style>
